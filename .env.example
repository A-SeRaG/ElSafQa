# Copy to .env.local for local work. On Vercel, set these in Project > Settings > Environment Variables.

# --- Public (built into the pages; a redeploy is needed after changing them) ---
PUBLIC_TELEGRAM_URL=https://t.me/elsafqa
PUBLIC_VIP_URL=https://t.me/TEAM_ElSafQa   # Telegram account for VIP subscriptions
PUBLIC_TURNSTILE_SITEKEY=            # Cloudflare Turnstile "site key"

# --- Contact form ---
TURNSTILE_SECRET=                    # Cloudflare Turnstile "secret key"
TELEGRAM_BOT_TOKEN=                  # from @BotFather
TELEGRAM_CHAT_ID=                    # chat that receives the messages

# --- /login app ---
DATABASE_URL=                        # Supabase "Transaction pooler" connection string (port 6543)
ADMIN_PASSWORD=
SESSION_SECRET=                      # openssl rand -hex 32
# ADMIN_EMAIL=support@elsafqa.com
# TEST_STAFF_PASSWORD=               # enables staff.test@elsafqa.com
# RESEND_API_KEY=                    # sign-in alert email
# MAIL_FROM=ElSafQa Admin <admin@elsafqa.com>
# ALERT_EMAIL_TO=
