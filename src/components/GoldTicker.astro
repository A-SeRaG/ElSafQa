---
import { content } from '../i18n/content';
import { GOLD_WS_URL } from '../config';
const { lang } = Astro.props;
const t = content[lang as 'en' | 'ar'].ticker;
---
<div id="gold-ticker" class="mt-10 border-s-2 border-gold ps-5" data-ws={GOLD_WS_URL} data-labels={JSON.stringify(t)}>
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-mute">
    <span id="gold-dot" class="inline-block h-2 w-2 rounded-full bg-mute"></span>
    <span>{t.label}</span>
    <span id="gold-status">{t.connecting}</span>
  </p>
  <p class="mt-1 flex flex-wrap items-baseline gap-x-3">
    <span id="gold-price" class="font-display text-6xl font-extrabold tabular-nums text-gold sm:text-7xl" aria-live="off">—</span>
    <span class="text-sm text-mute">{t.unit}</span>
  </p>
  <p class="mt-2 text-base text-mute">
    <span>{t.trendLabel}: </span>
    <span id="gold-trend" aria-live="polite" class="font-semibold">—</span>
  </p>
  <p class="mt-3 text-xs text-mute">{t.note}</p>
</div>
<script>import '../scripts/gold';</script>
