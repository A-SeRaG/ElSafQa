---
import Base from '../layouts/Base.astro';
import { content } from '../i18n/content';
import GoldTicker from './GoldTicker.astro';
import { TELEGRAM_URL, TURNSTILE_SITEKEY, CHANNEL_URLS, SUPPORT_TELEGRAM } from '../config';
const { lang } = Astro.props;
const t = content[lang as 'en' | 'ar'];
const p = lang === 'ar' ? '/ar' : '';
const alt = lang === 'ar' ? '/' : '/ar/';
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---
<Base lang={lang} path={`${p}/`} altPath={alt} title={t.meta.title} description={t.meta.desc}>
  <!-- Hero: text + live gold on the LEFT, logo on the RIGHT (physical layout, in both languages) -->
  <section class="hero-glow relative overflow-hidden">
    <div dir="ltr" class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 md:grid-cols-[1.1fr_.9fr] md:py-20">
      <div dir={dir} class="text-start">
        <h1 class="text-5xl font-extrabold sm:text-6xl lg:text-7xl">
          <span class="block text-ivory">{t.hero.l1}</span>
          <span class="block text-gold">{t.hero.l2}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ivory/85">{t.hero.sub}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={TELEGRAM_URL} rel="noopener noreferrer" class="btn btn-gold">{t.join}</a>
          <a href="#contact" class="btn btn-line">{t.talk}</a>
        </div>
        <GoldTicker lang={lang} />
        <p class="mt-6 max-w-xl text-sm text-mute">{t.hero.note}</p>
      </div>
      <img src="/images/emblem.webp" alt="ElSafQa" width="960" height="960" fetchpriority="high" class="emblem mx-auto w-full max-w-md" />
    </div>
  </section>

  <!-- About -->
  <section id="about" class="border-t border-edge">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="max-w-2xl text-3xl font-bold sm:text-4xl">{t.about.title}</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {t.about.items.map((i) => (
          <div class="border-s-2 border-gold ps-6">
            <h3 class="text-xl font-semibold text-gold">{i.h}</h3>
            <p class="mt-3 text-ivory/80">{i.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works (real sequence, so numbered) -->
  <section id="how" class="border-t border-edge bg-coal">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="max-w-2xl text-3xl font-bold sm:text-4xl">{t.how.title}</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-3">
        {t.how.steps.map((s, n) => (
          <li class="flex gap-5">
            <span class="font-display text-6xl font-extrabold leading-none text-gold-deep" aria-hidden="true">{n + 1}</span>
            <div><h3 class="text-xl font-semibold">{s.h}</h3><p class="mt-2 text-ivory/80">{s.p}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Channel -->
  <section id="channel" class="border-t border-edge">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <img src="/images/scalp-channel.webp" srcset="/images/scalp-channel-800.webp 800w, /images/scalp-channel.webp 1600w" sizes="(min-width: 1152px) 1112px, 100vw" alt={t.channel.alt} width="1600" height="900" loading="lazy" class="w-full border border-edge" />
      <div class="mt-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-xl"><h2 class="text-3xl font-bold sm:text-4xl">{t.channel.title}</h2><p class="mt-3 text-ivory/80">{t.channel.p}</p></div>
        <a href={TELEGRAM_URL} rel="noopener noreferrer" class="btn btn-gold shrink-0">{t.join}</a>
      </div>
      <div class="mt-20">
        <h3 class="text-2xl font-semibold">{t.channels.title}</h3>
        <p class="mt-2 max-w-xl text-ivory/80">{t.channels.p}</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {t.channels.items.map((c, i) => CHANNEL_URLS[i] ? (
            <a href={CHANNEL_URLS[i]} rel="noopener noreferrer" class="block border border-gold bg-coal p-6 transition-colors hover:bg-edge">
              <h4 class="font-display text-xl font-bold text-gold">{c.name}</h4>
              <p class="mt-2 text-ivory/80">{c.p}</p>
              <p class="mt-5 font-semibold text-gold">{t.channels.open} <span class="inline-block rtl:rotate-180" aria-hidden="true">→</span></p>
            </a>
          ) : (
            <div class="border border-dashed border-edge p-6 text-mute">
              <h4 class="font-display text-xl font-bold">{c.name}</h4>
              <p class="mt-2">{c.p}</p>
              <p class="mt-5 text-sm font-semibold uppercase text-gold-deep">{t.channels.soon}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Risk -->
  <section aria-label="Risk">
    <div class="mx-auto max-w-6xl px-5 pb-20">
      <p class="border-s-4 border-signal bg-coal px-6 py-5 text-ivory/90">{t.risk}</p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-edge bg-coal">
    <div class="mx-auto max-w-3xl px-5 py-20">
      <h2 class="text-3xl font-bold sm:text-4xl">{t.faq.title}</h2>
      <div class="mt-10 divide-y divide-edge border-y border-edge">
        {t.faq.items.map((f) => (
          <details class="py-5">
            <summary class="flex items-center justify-between gap-4 text-lg font-semibold">{f.q}<span class="plus text-2xl text-gold transition-transform" aria-hidden="true">+</span></summary>
            <p class="mt-3 text-ivory/80">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="border-t border-edge">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold sm:text-4xl">{t.contact.title}</h2>
        <p class="mt-4 max-w-md text-ivory/80">{t.contact.p}</p>
        <p class="mt-8 text-sm text-mute">{t.contact.or}</p>
        <ul class="mt-3 max-w-md space-y-3">
          <li>
            <a href={`https://t.me/${SUPPORT_TELEGRAM}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 border border-edge px-4 py-3 transition-colors hover:border-gold">
              <span class="text-sm text-mute">{t.contact.tgLabel}</span>
              <span dir="ltr" class="font-semibold text-gold">@{SUPPORT_TELEGRAM}</span>
            </a>
          </li>
        </ul>
      </div>
      <form id="contact-form" class="space-y-4" novalidate data-lang={lang} data-ok={t.contact.ok} data-err={t.contact.err} data-sending={t.contact.sending}>
        <div><label for="name" class="mb-1 block text-sm text-mute">{t.contact.name}</label><input class="field" id="name" name="name" required maxlength="80" autocomplete="name" /></div>
        <div><label for="email" class="mb-1 block text-sm text-mute">{t.contact.email}</label><input class="field" id="email" name="email" type="email" required maxlength="120" dir="ltr" autocomplete="email" inputmode="email" /></div>
        <div><label for="message" class="mb-1 block text-sm text-mute">{t.contact.msg}</label><textarea class="field" id="message" name="message" rows="5" required maxlength="1500"></textarea></div>
        <div class="absolute -start-[9999px]" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-theme="dark" data-language={lang}></div>
        <button type="submit" class="btn btn-gold">{t.contact.send}</button>
        <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
    </div>
  </section>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>import '../scripts/contact';</script>
</Base>
